---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import Evidence from './Evidence.astro';
import { profile, courses, type Lang } from '../data/profile';
import { getCollection } from 'astro:content';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = profile[lang];
const base = import.meta.env.BASE_URL;
const home = lang === 'zh' ? `${base}zh/` : base;
const projects = (await getCollection('projects', ({ data }) => data.lang === lang)).sort((a, b) => a.data.order - b.data.order);
const cv = `${base}documents/Nazhakaiti-Yusufu-CV.pdf`;
---
<Layout lang={lang}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow"><span class="tiny-star" aria-hidden="true">✧</span> {t.eyebrow}</p><p class="hello">{lang === 'en' ? 'Hello, I’m Nazhakaiti.' : '你好，我是 Nazhakaiti。'}</p><h1 id="hero-title">{t.title.split('\n').map(line => <span>{line}</span>)}</h1><p class="hero-intro">{t.intro}</p><div class="hero-buttons"><a class="button primary" href="#projects">{t.explore}<Icon /></a><a class="text-link" href={cv} download>{t.cv}<Icon name="down" /></a></div><p class="hero-role"><span class="status-dot"></span>{t.role}</p></div>
    <div class="hero-visual"><div class="photo-frame"><img src={`${base}images/portrait.webp`} width="900" height="1125" alt={lang === 'en' ? 'Portrait of Nazhakaiti Yusufu' : 'Nazhakaiti Yusufu的个人肖像'} fetchpriority="high" /><div class="photo-corner" aria-hidden="true">✧</div></div><div class="photo-label"><span>01 /</span><div>{profile.name}<small>{lang === 'en' ? 'Kashgar → Beijing → Venice' : '喀什 → 北京 → 威尼斯'}</small></div></div><div class="orbit-note" aria-hidden="true">LAND & LIFE<br />A PERSONAL JOURNEY</div></div>
  </section>
  <div class="highlights"><div class="container highlights-inner"><div><strong>01</strong><p>{lang === 'en' ? 'National First Prize' : '全国一等奖'}<small>{lang === 'en' ? 'Territorial spatial planning · 2025' : '国土空间规划竞赛 · 2025'}</small></p></div><div><strong>197</strong><p>{lang === 'en' ? 'Hours of service' : '小时志愿服务'}<small>{lang === 'en' ? 'Volunteering & student leadership' : '志愿服务与学生工作'}</small></p></div><div><strong>02</strong><p>{lang === 'en' ? 'Learning environments' : '段大学学习经历'}<small>{lang === 'en' ? 'Renmin University & Ca’ Foscari' : '中国人民大学与威尼斯东方大学'}</small></p></div></div></div>
  <section class="section container about" id="about"><div class="about-images"><figure class="journey-photo"><img src={`${base}images/journey.webp`} width="1200" height="1600" loading="lazy" alt={lang === 'en' ? 'Nazhakaiti standing inside a historic hall with a camera' : 'Nazhakaiti手持相机站在一座历史建筑的大厅中'} /><figcaption>{t.photoCaption}</figcaption></figure><div class="image-stamp" aria-hidden="true">✧</div></div><div class="about-copy"><p class="eyebrow">01 / {t.about}</p><h2>{t.aboutTitle}</h2><p>{t.bio}</p><p>{t.bio2}</p><aside class="aspiration"><span aria-hidden="true">↗</span><div><h3>{t.aspiration}</h3><p>{t.aspirationText}</p></div></aside></div></section>
  <section class="section education-section" id="education"><div class="container"><p class="eyebrow">02 / {t.education}</p><div class="section-heading"><h2>{t.educationTitle}</h2><span class="section-ornament" aria-hidden="true">✧</span></div><div class="education-grid"><article class="education-card"><p class="meta">{t.period}</p><h3>{t.university}</h3><p class="degree">{t.degree}</p><p class="muted">{t.location}</p><div class="grades"><div><strong>83.9<span>/100</span></strong><small>{t.average}</small></div><div><strong>3.24<span>/4.00</span></strong><small>GPA</small></div><div><strong>85.9<span>/100</span></strong><small>{t.relevant}</small></div></div></article><article class="education-card exchange-card"><p class="meta">{t.exchangePeriod}</p><p class="pill">{t.exchange}</p><h3>{t.exchangeUni}</h3><p>{t.exchangeDesc}</p><span class="exchange-graphic" aria-hidden="true">↗</span></article></div><details class="course-details"><summary>{t.courses}<span aria-hidden="true">+</span></summary><div class="course-list">{courses.map(c => <div><span>{c[lang === 'en' ? 0 : 1]}</span><strong>{c[2]}<small>/100</small></strong></div>)}</div></details></div></section>
  <section class="section container" id="experience"><p class="eyebrow">03 / {t.experience}</p><h2>{t.experienceTitle}</h2><div class="timeline">{t.experiences.map((e, i) => <article class="experience-row"><div class="experience-date"><span class="timeline-dot" aria-hidden="true"></span>{e.date}<small>0{i + 1}</small></div><div><h3>{e.title}</h3><p class="organization">{e.org}</p><p>{e.text}</p><div class="tags">{e.tags.map(tag => <span>{tag}</span>)}</div></div></article>)}</div><Evidence lang={lang} group="service" /></section>
  <section class="section projects-section" id="projects"><div class="container"><p class="eyebrow">04 / {t.projects}</p><div class="section-heading"><h2>{t.projectsTitle}</h2><p>{t.projectsIntro}</p></div><div class="projects-grid">{projects.map(({ data: p }) => <article class={`project-card project-${p.order}`}><a class="project-main" href={`${home}projects/${p.slug}/`}><div class="project-meta"><span>{p.category}</span><span>{p.date}</span></div><div class="project-art" aria-hidden="true"><div class="contours"></div><span class="art-number">0{p.order}</span><div class="art-grid"></div></div><div class="project-content"><div class="project-stat"><strong>{p.stat}</strong><span>{p.statLabel}</span></div><h3>{p.title}</h3><p>{p.summary}</p><span class="project-read">{t.read}<Icon /></span></div></a><div class="tags project-tags">{p.tags.map(tag => <span>{tag}</span>)}</div></article>)}</div><div class="awards"><h3>{t.awards}</h3>{t.honours.map(h => <div class="award-row"><span>{h[0]}</span><div><h4>{h[1]}</h4><p>{h[2]}</p></div><span class="award-star" aria-hidden="true">✧</span></div>)}</div></div></section>
  <section class="section container" id="skills"><p class="eyebrow">05 / {t.skills}</p><h2>{t.skillsTitle}</h2><div class="skills-grid">{t.skillGroups.map((s, i) => <article class="skill"><span class="skill-number">0{i + 1}</span><p class="meta">{s[0]}</p><h3>{s[1]}</h3><p>{s[2]}</p></article>)}</div><div class="personal-grid"><div class="language-panel"><h3>{t.languages}</h3><ul>{t.languageList.map(l => <li>{l}</li>)}</ul><h3 class="interests-heading">{t.interests}</h3><div class="tags">{t.interestList.map(i => <span>{i}</span>)}</div></div><figure class="london-photo"><img src={`${base}images/london.webp`} width="1200" height="1600" loading="lazy" alt={lang === 'en' ? 'Nazhakaiti with the Elizabeth Tower in London in the background' : 'Nazhakaiti在伦敦，身后是伊丽莎白塔'} /><figcaption>{t.londonCaption}</figcaption></figure></div></section>
  <section class="contact-section" id="contact"><div class="container contact-inner"><div><p class="eyebrow">06 / {t.contact}</p><h2>{t.contactTitle}</h2><p>{t.contactText}</p></div><div class="contact-links"><a class="email-link" href={`mailto:${profile.email}`}><span>{t.emailLabel}</span><strong>{profile.email}</strong><Icon name="arrow" /></a><a class="contact-cv" href={cv} download><Icon name="down" />{t.cv}<small>PDF · English · 145 KB</small></a></div></div><div class="contact-pattern" aria-hidden="true">✧</div></section>
</Layout>
